                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"база отвечает\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Список районов",
          "request": {
            "method": "GET",
