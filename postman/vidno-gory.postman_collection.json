    {
      "name": "2. Наблюдения (CRUD)",
      "item": [
        {
          "name": "Создать наблюдение",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"district\": \"turksib\",\n  \"visibility\": \"no\",\n  \"comment\": \"Смог, даже соседний дом в дымке\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"reportId\", r.id);",
                  "pm.test(\"id сохранён в reportId\", () => pm.expect(r.id).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Список наблюдений",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
                  "const id = Number(pm.collectionVariables.get(\"reportId\"));",
                  "pm.test(\"созданное наблюдение в списке\", () => pm.expect(pm.response.json().map(r => r.id)).to.include(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Список по району",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports?district=turksib&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ],
              "query": [
                {
                  "key": "district",
                  "value": "turksib"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"только Турксибский\", () => pm.response.json().forEach(r => pm.expect(r.district).to.eql(\"turksib\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Получить по id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/{{reportId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "{{reportId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"тот самый id\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"reportId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Обновить",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/{{reportId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "{{reportId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"district\": \"turksib\",\n  \"visibility\": \"partly\",\n  \"comment\": \"К обеду ветер разогнал смог\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"visibility изменилось\", () => pm.expect(pm.response.json().visibility).to.eql(\"partly\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Удалить",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/{{reportId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "{{reportId}}"
